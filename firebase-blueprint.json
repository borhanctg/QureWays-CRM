      "type": "object",
      "properties": {
        "patientCode": { "type": "string", "maxLength": 40 },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 140 },
        "age": { "type": "number" },
        "gender": { "type": "string", "maxLength": 30 },
        "phone": { "type": "string", "maxLength": 40 },
        "whatsapp": { "type": "string", "maxLength": 40 },
        "email": { "type": "string", "maxLength": 200 },
        "country": { "type": "string", "maxLength": 80 },
        "city": { "type": "string", "maxLength": 80 },
        "passportNumber": { "type": "string", "maxLength": 50 },
        "preferredLanguage": { "type": "string", "maxLength": 50 },
        "preferredChannel": { "type": "string", "maxLength": 50 },
        "emergencyContact": { "type": "string", "maxLength": 200 },
        "medicalHistorySummary": { "type": "string", "maxLength": 3000 },
        "existingDiagnoses": { "type": "string", "maxLength": 1500 },
        "reportedSymptoms": { "type": "string", "maxLength": 1500 },
        "previousTreatments": { "type": "string", "maxLength": 1500 },
        "treatmentRequirements": { "type": "string", "maxLength": 1500 },
        "preferredHospital": { "type": "string", "maxLength": 160 },
        "preferredDestination": { "type": "string", "maxLength": 120 },
        "assignedCoordinatorName": { "type": "string", "maxLength": 120 },
        "journeyStage": { "type": "string", "maxLength": 80 },
        "dataProcessingConsent": { "type": "boolean" },
        "marketingConsent": { "type": "boolean" },
        "ownerId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "patientCode",
        "fullName",
        "age",
        "gender",
        "phone",
        "country",
        "city",
        "preferredLanguage",
        "preferredHospital",
        "preferredDestination",
        "assignedCoordinatorName",
        "journeyStage",
        "dataProcessingConsent",
        "marketingConsent",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "MedicalDocument": {
      "title": "MedicalDocument",
