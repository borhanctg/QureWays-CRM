  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Staff and patient user accounts with RBAC roles."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Admin role lookup collection."
    },
    "/leads/{leadId}": {
      "schema": { "$ref": "#/entities/Lead" },
      "description": "Inbound inquiries and lead management pipeline."
    },
    "/patients/{patientId}": {
      "schema": { "$ref": "#/entities/Patient" },
      "description": "Unified patient records."
    },
    "/medicalDocuments/{docId}": {
      "schema": { "$ref": "#/entities/MedicalDocument" },
      "description": "Patient uploaded medical documents and extracted text."
    },
    "/aiReports/{reportId}": {
      "schema": { "$ref": "#/entities/AiMedicalReport" },
      "description": "AI-assisted preliminary medical reports and review states."
    },
    "/secondOpinions/{opinionId}": {
      "schema": { "$ref": "#/entities/HospitalSecondOpinion" },
      "description": "Hospital second opinion requests and clinical responses."
    },
    "/costEstimates/{estimateId}": {
      "schema": { "$ref": "#/entities/TreatmentCostEstimate" },
      "description": "Itemized treatment and medical tourism cost estimates."
    },
    "/serviceBookings/{bookingId}": {
      "schema": { "$ref": "#/entities/ServiceBooking" },
      "description": "Appointments, teleconsultations, visa letters, and travel services."
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/FollowUpTask" },
      "description": "Follow-up tasks and automation reminders."
    },
    "/communications/{commId}": {
      "schema": { "$ref": "#/entities/CommunicationRecord" },
      "description": "Unified inbound and outbound communication logs."
    },
    "/hospitals/{hospitalId}": {
      "schema": { "$ref": "#/entities/HospitalDirectoryEntry" },
      "description": "Verified partner hospitals and doctors."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLogEntry" },
      "description": "Security and record access audit trail."
    }
  }
}
