{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated staff member or patient user profile with role-based permissions.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 120 },
        "role": {
          "type": "string",
          "enum": [
            "CRM Administrator",
            "Patient Relationship Manager",
            "Medical Report Coordinator",
            "Hospital Coordination Officer",
            "Travel and Visa Coordinator",
            "Authorized Management Staff",
            "Patient"
          ]
        },
        "department": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 40 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "active", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator lookup document.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Lead": {
      "title": "Lead",
      "description": "Inbound medical tourism inquiry and lead pipeline record.",
      "type": "object",
      "properties": {
        "leadCode": { "type": "string", "maxLength": 40 },
        "patientName": { "type": "string", "minLength": 1, "maxLength": 140 },
        "phone": { "type": "string", "maxLength": 40 },
        "whatsapp": { "type": "string", "maxLength": 40 },
        "email": { "type": "string", "maxLength": 200 },
        "country": { "type": "string", "maxLength": 80 },
        "city": { "type": "string", "maxLength": 80 },
        "preferredLanguage": { "type": "string", "maxLength": 50 },
        "inquiryDate": { "type": "string", "maxLength": 40 },
        "leadSource": { "type": "string", "maxLength": 80 },
        "campaignSource": { "type": "string", "maxLength": 120 },
        "interestedTreatment": { "type": "string", "maxLength": 160 },
        "preferredHospital": { "type": "string", "maxLength": 160 },
        "preferredCountry": { "type": "string", "maxLength": 80 },
        "needsDescription": { "type": "string", "maxLength": 2000 },
        "assignedStaffName": { "type": "string", "maxLength": 120 },
        "priority": { "type": "string", "enum": ["Urgent", "High", "Medium", "Low"] },
        "nextFollowUpDate": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "maxLength": 80 },
        "lostReason": { "type": "string", "maxLength": 400 },
        "consentGiven": { "type": "boolean" },
        "privacyPreferences": { "type": "string", "maxLength": 300 },
        "convertedPatientId": { "type": "string", "maxLength": 128 },
        "internalNotes": { "type": "string", "maxLength": 2000 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "leadCode",
        "patientName",
        "phone",
        "country",
        "city",
        "preferredLanguage",
        "inquiryDate",
        "leadSource",
        "interestedTreatment",
        "preferredHospital",
        "assignedStaffName",
        "priority",
        "status",
        "consentGiven",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "Patient": {
      "title": "Patient",
